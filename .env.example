# Netdata Multi-Instance Aggregator Configuration

# Hosts are configured in config/hosts.txt file (one URL per line)
# See config/hosts.txt for configuration
HOSTS_FILE=config/hosts.txt

# Alert polling interval in seconds (default: 15)
ALERT_POLL_INTERVAL=15

# Timeout for Netdata requests in seconds (default: 5)
REQUEST_TIMEOUT=5

# Netdata Health Management API (backend only)
NETDATA_MANAGEMENT_ENABLED=false
NETDATA_MANAGEMENT_API_TOKEN=
NETDATA_MANAGEMENT_API_TOKEN_FILE=

# Backend API port (default: 8000)
PORT=8000

# Frontend port (development only, default: 3000)
FRONTEND_PORT=3000

# --- Authentication (LDAP) ---------------------------------------------------
# Enforced on the backend. When true, the variables marked (required) below must be set.
AUTH_ENABLED=false

# LDAP server. Use ldaps:// for TLS, or ldap:// together with LDAP_START_TLS=true.
LDAP_URL=ldaps://ldap.example.com:636          # (required)
LDAP_START_TLS=false
LDAP_TLS_VALIDATE=true
LDAP_CA_CERT_FILE=
LDAP_CONNECT_TIMEOUT=5

# Optional service account for the initial DN lookup. Leave empty for anonymous lookup.
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_BIND_PASSWORD_FILE=

# How to locate the user. {username} is escaped before substitution.
# OpenLDAP: (uid={username})   Active Directory: (sAMAccountName={username})
LDAP_USER_BASE_DN=ou=people,dc=example,dc=com  # (required)
LDAP_USER_FILTER=(uid={username})
LDAP_DISPLAY_NAME_ATTR=cn

# Access is limited to members of this group DN. The backend first checks
# LDAP_GROUP_ATTR on the user entry, then falls back to a FreeIPA-style group
# search with member=<user_dn>.
LDAP_REQUIRED_GROUP=cn=netdata-admins,ou=groups,dc=example,dc=com  # (required)
LDAP_GROUP_ATTR=memberOf

# Session cookie signing key. (required) Generate with: openssl rand -hex 32
SESSION_SECRET=
SESSION_SECRET_FILE=
# Session lifetime in seconds (default: 8h).
SESSION_TTL=28800
# Set to true when the portal is served over HTTPS.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
